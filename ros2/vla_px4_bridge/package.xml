<?xml version="1.0"?>
<package format="3">
  <name>vla_px4_bridge</name>
  <version>0.1.0</version>
  <description>Offboard node with a safety supervisor between VLA goals and PX4 (VLA course, Appendix B).</description>
  <maintainer email="mattia.mantovani99@gmail.com">Mattia Mantovani</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
